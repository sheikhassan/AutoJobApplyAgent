# --- Search providers ---
EXA_API_KEY=
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://api.tinyfish.ai/v1
EXA_QUERY_BUDGET=8
EXA_MAX_RESULTS_PER_QUERY=5
EXA_CONTENTS_LIMIT=5

# --- Model provider ---
USE_MODEL=true
MODEL_TARGETS=qwen=accounts/fireworks/models/qwen3p7-plus:3,deepseek=accounts/fireworks/models/deepseek-v4-flash:2
FIREWORKS_MODEL=accounts/fireworks/models/qwen3p7-plus
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_API_KEY=

# --- Database ---
DATABASE_URL=postgresql://jobhunter:change-me@postgres:5432/jobhunter

# --- Email: every important agent update goes here ---
EMAIL_UPDATES=true
NOTIFY_TO=sheikhasan44@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=30

# --- Dashboard security ---
AUTH_REQUIRED=true
DASHBOARD_PASSWORD=change-this-immediately
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
COOKIE_SAMESITE=none
CORS_ORIGINS=https://jobs.example.com

# --- Scheduler ---
JOB_HUNTER_TIMES=06:00,08:00,13:00,22:00,00:00
JOB_HUNTER_HOUR=8
JOB_HUNTER_MINUTE=0
JOB_HUNTER_TIMEZONE=Asia/Kolkata
JOB_HUNTER_DAYS=mon-sun
RUN_SCHEDULED_SCAN_ON_STARTUP=false
MAX_PACKAGES_PER_RUN=10
MIN_MATCH_SCORE=0.60
LOG_LEVEL=INFO

# Cybersecurity / production hardening
REDIS_URL=redis://redis:6379/0
CSRF_PROTECTION=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=120
LOGIN_RATE_LIMIT=8
REQUIRE_HTTPS=true
COOKIE_SECURE=true
CONTENT_SECURITY_POLICY=default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https:; form-action 'self'
DOMAIN=jobs.example.com
NEXT_PUBLIC_API_URL=

# Production PostgreSQL pooling / performance
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=12
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_MAX_IDLE_SECONDS=300
DB_POOL_MAX_LIFETIME_SECONDS=1800

# Production Redis cache / distributed coordination
REDIS_PASSWORD=change-this-redis-password
REDIS_URL=redis://:change-this-redis-password@redis:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1.5
REDIS_SOCKET_TIMEOUT_SECONDS=1.5
CACHE_REQUIRED=true
CACHE_DEFAULT_TTL_SECONDS=30
CACHE_DASHBOARD_TTL_SECONDS=15
CACHE_JOBS_TTL_SECONDS=20
CACHE_APPLICATIONS_TTL_SECONDS=20
CACHE_RUNS_TTL_SECONDS=20
CACHE_NOTIFICATIONS_TTL_SECONDS=30
CACHE_SOURCES_TTL_SECONDS=60
AGENT_RUN_LOCK_SECONDS=1800

# Safe automatic recruiter/hiring-contact outreach (explicit opt-in; default off)
COLD_OUTREACH_ENABLED=false
COLD_OUTREACH_DAILY_LIMIT=5
